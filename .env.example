# Copia a .env:  Copy-Item .env.example .env
# Spring Boot lee NEON_DB_* (ver application.properties).
# Los defaults del equipo están como placeholders en application.properties; en local usa .env con tus valores.

NEON_DB_URL=jdbc:postgresql://TU_HOST_NEON:5432/bancodigital?sslmode=require
NEON_DB_USER=tu_usuario_neon
NEON_DB_PASSWORD=tu_password_neon
